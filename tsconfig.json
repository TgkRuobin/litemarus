{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "noEmit": false,
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/wasm/**"]
}
